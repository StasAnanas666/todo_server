generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url = "file:./todos.db"
}

model Role {
    id Int @id @default(autoincrement())
    role String @unique
    users User[]
}

model User {
    id Int @id @default(autoincrement())
    username String @unique
    email String @unique
    password String
    roleId Int
    role Role @relation(fields: [roleId], references: [id])
    tasks Task[]
}

model Task {
    id Int @id @default(autoincrement())
    title String 
    deadline DateTime
    priority String
    userId Int
    status String @default("new")
    user User? @relation(fields: [userId], references: [id])
}



